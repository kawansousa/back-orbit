# MongoDB — Banco por ambiente (NODE_ENV decide qual usar)
NODE_ENV=development
MONGODB_URI_DEV=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/APP_DEV?retryWrites=true&w=majority
MONGODB_URI_PROD=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/APP_PROD?retryWrites=true&w=majority
MONGODB_URI_TEST=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/APP_TEST?retryWrites=true&w=majority

# Fallback (usado se a URI específica do ambiente não existir)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DATABASE?retryWrites=true&w=majority

# Server
PORT=3333

# JWT
JWT_SECRET=your_jwt_secret_here

# CORS - origens permitidas separadas por vírgula
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=info
